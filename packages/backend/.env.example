JWT_SECRET_KEY=This_is_JWT_SECRET_KEY_DESNE
JWT_EXPIRE_MINUTES=480


# Databases
## Postgres
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ontomatic

# Read only when creating users for the first time; use separate passwords of 12-30 characters.
INITIAL_ADMIN_PASSWORD=
INITIAL_RD_PASSWORD=
INITIAL_QA_PASSWORD=
INITIAL_PM_PASSWORD=

## Neo4j
GRAPH_RAG_ENABLED=true
NEO4J_URL=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
NEO4J_PASSWORD=

# Storage
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=true
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=root
S3_SECRET_ACCESS_KEY=root
S3_ADDRESSING_STYLE=path
S3_BUCKET=ontomatic

# Langfuse
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="http://localhost:3000"

# AIs
## Parsers
PARSER_PROVIDER=local

## Embedders
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b

## LLMs
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# APIs

## API Base URLS
OLLAMA_BASE_URL=http://localhost:11434
UPSTAGE_BASE_URL=https://api.upstage.ai/v1

## API Keys
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
UPSTAGE_API_KEY=
